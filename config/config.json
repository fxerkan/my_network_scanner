{
  "scan_settings": {
    "ip_ranges": [
      "192.168.1.0/24",
      "192.168.0.0/24",
      "10.0.0.0/24"
    ],
    "default_ip_range": "192.168.1.0/24",
    "timeout": 10,
    "max_threads": 20,
    "include_offline": true
  },
  "port_settings": {
    "default_ports": [
      21,
      22,
      23,
      25,
      53,
      80,
      139,
      443,
      445,
      515,
      554,
      631,
      1883,
      2020,
      3389,
      5000,
      5001,
      5900,
      8000,
      8008,
      8080,
      8443,
      8554,
      8899,
      9100,
      10554
    ],
    "device_specific_ports": {
      "Camera": [
        80,
        443,
        554,
        8080,
        8443
      ],
      "Printer": [
        80,
        443,
        515,
        631,
        9100
      ],
      "Router": [
        22,
        23,
        80,
        443,
        8080
      ],
      "Server": [
        22,
        80,
        443,
        8080,
        88
      ],
      "IP Camera": [
        80,
        443,
        554,
        2020,
        8000,
        8080,
        8443,
        8554,
        8899,
        10554,
        34567,
        37777
      ]
    }
  },
  "detection_rules": {
    "hostname_patterns": [
      {
        "pattern": ".*router.*|.*gateway.*|.*modem.*",
        "type": "Router"
      },
      {
        "pattern": ".*camera.*|.*cam.*|.*ipcam.*",
        "type": "IP Camera"
      },
      {
        "pattern": ".*printer.*|.*print.*",
        "type": "Printer"
      },
      {
        "pattern": ".*tv.*|.*smart.*tv.*",
        "type": "Smart TV"
      },
      {
        "pattern": ".*nas.*|.*storage.*",
        "type": "NAS"
      },
      {
        "pattern": ".*phone.*|.*mobile.*",
        "type": "Smartphone"
      },
      {
        "pattern": ".*tablet.*|.*ipad.*",
        "type": "Tablet"
      },
      {
        "pattern": ".*laptop.*|.*notebook.*",
        "type": "Laptop"
      },
      {
        "pattern": ".*desktop.*|.*pc.*",
        "type": "Desktop"
      },
      {
        "pattern": ".*xbox.*|.*playstation.*|.*nintendo.*",
        "type": "Gaming Console"
      }
    ],
    "vendor_patterns": [
      {
        "pattern": "Apple.*",
        "type": "Smartphone",
        "conditions": [
          "iphone",
          "ios"
        ]
      },
      {
        "pattern": "Apple.*",
        "type": "Tablet",
        "conditions": [
          "ipad"
        ]
      },
      {
        "pattern": "Apple.*",
        "type": "Laptop",
        "conditions": [
          "macbook",
          "mac"
        ]
      },
      {
        "pattern": "Samsung.*",
        "type": "Smartphone",
        "conditions": [
          "galaxy",
          "android"
        ]
      },
      {
        "pattern": "Samsung.*",
        "type": "Smart TV",
        "conditions": [
          "tv",
          "display"
        ]
      },
      {
        "pattern": "LG.*",
        "type": "Smart TV",
        "conditions": [
          "tv",
          "display"
        ]
      },
      {
        "pattern": "Sony.*",
        "type": "Gaming Console",
        "conditions": [
          "playstation"
        ]
      },
      {
        "pattern": "Microsoft.*",
        "type": "Gaming Console",
        "conditions": [
          "xbox"
        ]
      },
      {
        "pattern": "TP-Link.*|TpLink.*",
        "type": "Router",
        "conditions": [
          "router",
          "gateway",
          "archer",
          "deco",
          "modem",
          "ap",
          "wifi"
        ]
      },
      {
        "pattern": "Asus.*",
        "type": "Router",
        "conditions": [
          "router",
          "gateway",
          "archer",
          "deco",
          "modem",
          "ap",
          "wifi"
        ]
      },
      {
        "pattern": "Netgear.*",
        "type": "Router",
        "conditions": [
          "router",
          "gateway",
          "archer",
          "deco",
          "modem",
          "ap",
          "wifi"
        ]
      },
      {
        "pattern": "Dyson.*",
        "type": "Smart Home"
      },
      {
        "pattern": "Xiaomi.*",
        "type": "Smartphone",
        "conditions": [
          "redmi",
          "mi phone",
          "poco",
          "android"
        ]
      },
      {
        "pattern": "Petkit.*",
        "type": "Pet Feeder"
      }
    ],
    "combined_rules": [
      {
        "vendor": "Apple",
        "hostname": "macbook|imac|mac-?mini|mac-?pro|mac-?studio",
        "type": "Laptop"
      },
      {
        "vendor": "Apple",
        "hostname": "iphone",
        "type": "Smartphone"
      },
      {
        "vendor": "Apple",
        "hostname": "ipad",
        "type": "Tablet"
      },
      {
        "vendor": "Apple",
        "hostname": "apple-?tv|appletv",
        "type": "Smart TV"
      },
      {
        "vendor": "Apple",
        "hostname": "watch",
        "type": "Smart Watch"
      },
      {
        "vendor": "Samsung",
        "hostname": "galaxy|sm-[a-z]",
        "type": "Smartphone"
      },
      {
        "vendor": "Samsung|LG",
        "hostname": "\\btv\\b|smart-?tv",
        "type": "Smart TV"
      },
      {
        "vendor": "Raspberry",
        "hostname": ".*",
        "type": "Single Board Computer"
      }
    ]
  },
  "smart_naming": {
    "enabled": true,
    "info": "Smart naming özellikleri artık sadece 'Toplu Detaylı Analiz' butonunda çalışır. Normal tarama hızlıdır.",
    "auto_alias": true,
    "hostname_resolution": true,
    "advanced_scanning": true,
    "resolve_hostnames": true,
    "confidence_threshold": 0.5,
    "methods": {
      "standard_dns": true,
      "reverse_dns": true,
      "netbios": true,
      "mdns": true,
      "smb_enumeration": true,
      "snmp_hostname": true,
      "rdn_analysis": true,
      "lazy_text_analysis": true,
      "web_content_analysis": true,
      "banner_grabbing": true,
      "certificate_analysis": true
    },
    "advanced_info_gathering": {
      "enabled": true,
      "timeout": 5,
      "max_threads": 10,
      "cache_timeout": 3600,
      "gather_system_info": true,
      "gather_network_info": true,
      "gather_service_info": true,
      "gather_security_info": true
    },
    "alias_generation": {
      "use_vendor": true,
      "use_model": true,
      "use_hostname": true,
      "use_location": true,
      "use_device_type": true,
      "fallback_patterns": [
        "{vendor} {model}",
        "{vendor} {type}",
        "{type}-{location}",
        "{type}-{number}"
      ]
    }
  },
  "security_settings": {
    "_note": "Master password buraya YAZILMAZ. MYNES_PASSWORD env var veya config/.master_password (git'e girmez) kullanin."
  },
  "monitoring": {
    "enabled": true,
    "interval_minutes": 15,
    "include_offline": true,
    "run_discovery": true,
    "discovery_timeout": 6,
    "notify_channels": [],
    "enabled_rules": null,
    "thresholds": {
      "battery_percent": 20,
      "latency_ms": 500,
      "offline_scans": 3,
      "rssi_dbm": -85,
      "voltage_min": 4.7
    },
    "publish_to_mqtt": false
  },
  "discovery": {
    "mdns": true,
    "ssdp": true,
    "mqtt": true,
    "ble": true,
    "timeout": 8
  },
  "security": {
    "cve_source": "circl",
    "cve_sync_enabled": true,
    "cve_sync_interval_days": 30,
    "cve_last_sync": "2026-08-10T05:52:58.800027+00:00"
  }
}