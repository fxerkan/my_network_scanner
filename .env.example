# MyNeS configuration template. Copy to .env and fill in.
# Real environment variables always win over anything set here.
# A template without secrets lives in .env.example.

# ---------------------------------------------------------------- server ---
MYNES_PORT=5883
MYNES_HOST=0.0.0.0
# 1/true enables the Flask debug reloader. Never enable on a shared network.
MYNES_DEBUG=false
# Set to true only when MyNeS is served over HTTPS (makes session cookies Secure).
MYNES_HTTPS=false
# Signs session cookies. Changing it signs everyone out.
MYNES_SECRET_KEY=

# ------------------------------------------------------------------ paths ---
# Override where config/ and data/ live (useful in Docker). Defaults sit
# alongside the package.
#MYNES_HOME=/app
#MYNES_CONFIG_DIR=/app/config
#MYNES_DATA_DIR=/app/data

# --------------------------------------------------------- login (web UI) ---
# Used only when "Require sign-in" is switched on in Settings.
# For a hashed password instead of plaintext:  python -m mynes.web.auth --hash
MYNES_AUTH_USERNAME=admin
MYNES_AUTH_PASSWORD=secretpassword

# ---------------------------------------- credential store (device logins) ---
# Master password for the encrypted SSH/FTP/HTTP credentials MyNeS stores.
# Leave unset and one is generated into config/.master_password on first run.
#MYNES_PASSWORD=

# -------------------------------------------------------- Home Assistant ---
# Long-lived access token: HA → profile → Security → Long-lived access tokens.
HA_URL=
HA_TOKEN=
# Discovery topic prefix MyNeS publishes under (must match HA's setting).
#MYNES_HA_DISCOVERY_PREFIX=homeassistant

# --------------------------------------------- AI device identification ---
# Lets the "AI identify" agent research a device on the web (manuals, OUI DBs,
# support pages) and write an enhanced-analysis section. You bring your own key;
# it is used only for that on-demand, per-device action. Only 'anthropic' is
# wired today: 'anthropic', 'openai', and 'openrouter'. Set the key under its
# provider's standard name, or the generic MYNES_AI_API_KEY (wins for any
# provider). Pick the provider with MYNES_AI_PROVIDER; model/host then default
# to that provider's own (e.g. openrouter -> openai/gpt-4o-mini via the gateway).
ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#OPENROUTER_API_KEY=
#MYNES_AI_API_KEY=
# Optional overrides (defaults are per-provider):
#MYNES_AI_PROVIDER=anthropic
#MYNES_AI_MODEL=claude-opus-4-8

# ------------------------------------------------------------------- MQTT ---
# Needed to discover Zigbee2MQTT / Z-Wave JS / Tasmota devices, and to publish
# MyNeS devices into Home Assistant via MQTT discovery.
MYNES_MQTT_HOST=
MYNES_MQTT_PORT=1883
MYNES_MQTT_USERNAME=
MYNES_MQTT_PASSWORD=
